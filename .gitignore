# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...trừ file mẫu chỉ chứa placeholder, không chứa giá trị thật
!.env*.example

# vercel
.vercel

# supabase CLI local cache (không phải secret, chỉ là cache công cụ)
/supabase/.temp

# scratch scripts for manual QA/data seeding — never committed
/.vqa-tmp

# typescript
*.tsbuildinfo
next-env.d.ts
