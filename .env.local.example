# Bản mẫu biến môi trường cho VHKP — KHÔNG chứa giá trị thật.
# Sao chép thành .env.local (đã được .gitignore bỏ qua) và điền giá trị thật khi bắt đầu Slice 1.
#
# Không commit .env.local hay bất kỳ file .env* nào chứa giá trị thật.

# --- Public / client-side (an toàn khi lộ ra trình duyệt — RLS đã bật bảo vệ) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only (KHÔNG BAO GIỜ được lộ ra trình duyệt — dùng trong Server Action) ---
# service_role bypass RLS theo thiết kế của Supabase — chỉ dùng ở server.
SUPABASE_SERVICE_ROLE_KEY=
